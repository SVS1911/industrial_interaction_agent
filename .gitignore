# ============================================================
# INDUSTRY INTERACTION AGENT
# Root .gitignore
# ============================================================


# ============================================================
# 🔐 ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
!.env.example

backend/.env
backend/.env.*
!backend/.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

# Secrets / credentials
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
service-account*.json


# ============================================================
# 🐍 PYTHON / FASTAPI BACKEND
# ============================================================

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python compiled files
*.pyc
*.pyo
*.pyd

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python tools
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/


# ============================================================
# 🗄️ DATABASE / LOCAL DATA
# ============================================================

# SQLite
*.db
*.sqlite
*.sqlite3

# Local database folders
database/
databases/
db_data/

# PostgreSQL local dumps
*.dump
*.sql.bak

# Generated/local data
data/
datasets/
storage/
uploads/


# ============================================================
# 📁 TEMPORARY / GENERATED FILES
# ============================================================

tmp/
temp/
.cache/
.cache-loader/

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo


# ============================================================
# 📝 LOGS
# ============================================================

*.log
logs/
log/


# ============================================================
# ⚛️ REACT / VITE FRONTEND
# ============================================================

# Node dependencies
node_modules/
**/node_modules/

# Vite
.vite/
**/.vite/

# Production builds
dist/
**/dist/

# React build
build/
**/build/

# npm
npm-debug.log*
npm-error.log*

# Yarn
yarn-debug.log*
yarn-error.log*
yarn-error.log

# pnpm
pnpm-debug.log*
pnpm-error.log*


# ============================================================
# 📦 PACKAGE MANAGER
# ============================================================

# Optional package manager caches
.npm/
.yarn/
.pnpm-store/

# Do NOT ignore these:
# package.json
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


